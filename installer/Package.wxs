<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Youtube Downloader &amp; MP3"
           Manufacturer="Maik Neumann"
           Version="$(Version)"
           UpgradeCode="6B1D5C0E-3F54-4C57-9A0B-7D2E8C4A1F10"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Youtube Downloader" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Files Include="$(SourceDir)\**" />

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="AppShortcut"
                Name="Youtube Downloader &amp; MP3"
                Target="[INSTALLFOLDER]youtube_downloader.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\MaikNeumann\YoutubeDownloader"
                     Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
